# 环境变量配置示例

# MySQL配置
MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=classroom_attendance
MYSQL_USER=attendance
MYSQL_PASSWORD=attendance123

# Spring Boot配置
SPRING_PROFILES_ACTIVE=prod

# 应用配置
APP_NAME=classroom-attendance
APP_VERSION=1.0.0

# ===== 安全配置（② JWT → httpOnly Cookie 等）=====
# JWT 密钥：必填，≥32 字节（此处为 64 位十六进制 = 32 字节）。
# ⚠️ 生产环境必须换成你自己的随机值，且不要提交到仓库（用真实 .env，已被 .gitignore 忽略）。
JWT_SECRET=8d75375497c9874fb19acd17fcc7fa9b5a1de03e751d07809336518d4ae7f9ed

# Cookie 的 Secure 标记：本地 HTTP 联调保持 false；生产 HTTPS 改为 true。
JWT_COOKIE_SECURE=false

# CORS 显式允许来源（allowCredentials=true 下不能用 *，多个用逗号分隔）。
# 容器内前端默认 80 端口；本地直接跑前端 dev 一般是 http://localhost:5173。
CORS_ALLOWED_ORIGINS=http://localhost:80,http://localhost

# 后端 → 算法服务地址（容器内用服务名 algorithm）
ALGORITHM_BASE_URL=http://algorithm:5000

# 算法服务访问密钥（与 algorithm-service/.env 的 ALGORITHM_API_KEY 保持一致；留空则算法受保护接口拒绝访问）
ALGORITHM_API_KEY=
