# ============================================================
# 算法服务（Flask / gunicorn）启动所需环境变量
# 说明：app.py 通过 os.environ 读取以下变量。可用 python-dotenv 或 export 注入。
#       例如：export ALGORITHM_API_KEY=xxx && gunicorn -c gunicorn.conf.py app:app
# ============================================================

# 【必填】API 访问密钥。所有业务接口需带请求头 Authorization: Bearer <key>，
#         否则返回 401。不设则服务虽能启动，但所有接口都拒绝访问。
ALGORITHM_API_KEY=

# CORS 跨域白名单（逗号分隔），填前端/小程序域名；留空则拒绝跨域请求。
ALGORITHM_CORS_ORIGINS=

# 推理设备：cpu 或 cuda。本机无 GPU，用 cpu。
DEVICE=cpu

# 单次上传体积上限（MB），默认 50。
ALGORITHM_MAX_UPLOAD_MB=50
