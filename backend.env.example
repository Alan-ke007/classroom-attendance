# ============================================================
# 后端 Spring Boot 启动所需环境变量（独立运行后端，非 docker-compose 时使用）
# 说明：Spring Boot 直接读取“系统环境变量”，不需要 .env 文件。
#       用以下方式之一注入：
#         - 终端：export JWT_SECRET=xxx  然后启动
#         - IDE（如 IntelliJ）：Run/Debug 配置的 Environment variables
#       不要把真实密钥写进提交；本文件仅为模板（.example 不会被加载）。
# ============================================================

# 【必填】JWT 签名密钥，至少 32 字节。生成示例：openssl rand -hex 32
# 不设或不足 32 字节，后端启动会直接报错退出。
JWT_SECRET=

# ② 安全：Cookie 的 Secure 标记。本地 HTTP 联调保持 false；生产 HTTPS 改为 true。
JWT_COOKIE_SECURE=false

# CORS 跨域白名单（逗号分隔）。生产填前端真实域名；
# 本地开发留空即放行本机任意端口（localhost:5173 等），方便联调。
CORS_ALLOWED_ORIGINS=

# ③ 安全：后端 → 算法服务地址与密钥（仅后端持有，前端永不直接接触）。
# 本地算法服务默认 http://localhost:5000；留空 ALGORITHM_API_KEY 则算法受保护接口拒绝访问。
ALGORITHM_BASE_URL=http://localhost:5000
ALGORITHM_API_KEY=

# 数据库（默认值可直接用，但本机需先装并启动 MySQL，且已建库 classroom_attendance）
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/classroom_attendance?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=UTF-8&useUnicode=true&connectionCollation=utf8mb4_unicode_ci&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root
